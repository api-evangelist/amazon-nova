  "info": {
    "_postman_id": "58e76093-aef4-4643-bca4-69ce1983a567",
    "name": "Amazon Nova on Amazon Bedrock Runtime Async API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Invoke Amazon Nova foundation models (Premier, Pro, Lite, Micro, Canvas,\nReel, Sonic) through the Amazon Bedrock Runtime API. Supports\nrequest/response and streaming inference using the Converse and\nInvokeModel families of operations, plus asynchronous invocation for\nlong-running tasks like Nova Reel video generation.\nAll requests are signed with AWS Signature Version 4 (SigV4).\n\n\nContact Support:\n Name: Amazon Web Services",
      "type": "text/plain"
    }
  }
